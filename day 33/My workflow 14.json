    {
      "parameters": {
        "jsCode": "// Deterministic normalization of the raw form submission.\n// No AI involved here on purpose — this is pure data hygiene.\nconst f = $input.item.json;\n\nconst name = String(f['Full Name'] || '').trim();\nconst email = String(f['Email'] || '').trim().toLowerCase();\nconst position = String(f['Position Applying For'] || '').trim();\nconst yearsRaw = f['Years of Experience'];\nconst years = Number.isFinite(Number(yearsRaw)) ? Number(yearsRaw) : 0;\nconst resumeText = String(f['Resume / CV (paste as text)'] || '').replace(/\\s+/g, ' ').trim();\nconst linkedin = String(f['LinkedIn URL'] || '').trim();\n\n// Basic validation — deterministic error handling before anything costs an AI call\nconst errors = [];\nif (!name) errors.push('Missing name');\nif (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email)) errors.push('Invalid email');\nif (!position) errors.push('Missing position');\nif (resumeText.length < 30) errors.push('Resume text too short to analyze');\n\nreturn [{\n  json: {\n    name, email, position, years_experience: years,\n    resume_text: resumeText, linkedin_url: linkedin,\n    submitted_at: new Date().toISOString(),\n    validation_errors: errors,\n    is_valid: errors.length === 0,\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
