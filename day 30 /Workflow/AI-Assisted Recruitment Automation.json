    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a recruitment screening assistant. Analyze this candidate for the role below and extract structured information. AI assists only — you do NOT make the final hiring decision.\n\nPosition: {{ $('Extract Candidate Information').item.json.position }}\nYears of experience (self-reported): {{ $('Extract Candidate Information').item.json.years_experience }}\nResume:\n{{ $('Extract Candidate Information').item.json.resume_text }}\n\nRequired core skills for this role: JavaScript, SQL, REST APIs, Problem Solving.\n\nReturn ONLY a single valid JSON object (no markdown fences, no extra text) with these keys:\n- skills: array of skill strings found in the resume\n- experience_years: your best-estimate number of relevant years (may differ from self-reported)\n- score: integer 0-100 rating overall fit for the role\n- recommendation: one of \"Shortlist\", \"Reject\", \"Manual Review\"\n- reason: one or two sentence justification\n",
        "messages": {
          "messageValues": []
        },
        "batching": {}
      },
      "id": "f2a80c71-f0ea-4e37-8298-601ea84e47c1",
      "name": "AI Analysis + Skills Extraction",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        -736,
        128
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.1-flash-lite",
        "options": {}
      },
      "id": "9ce09827-afab-46c4-a9f1-08171e8e97b8",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        -736,
        320
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "googlePalmApi": {
          "id": "2iuYFOKF0RtEigVq",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Deterministic parse/repair/validate of the Gemini output.\n// Learned from Day 29: never spend a second AI call just to fix JSON formatting.\nconst raw = $input.item.json.text ?? '';\nlet text = String(raw).trim().replace(/^```(?:json)?/i, '').replace(/```$/, '').trim();\n\nfunction tryParse(s) { try { return JSON.parse(s); } catch (e) { return null; } }\n\nlet parsed = tryParse(text);\nif (!parsed) {\n  const m = text.match(/\\{[\\s\\S]*\\}/);\n  if (m) parsed = tryParse(m[0]);\n}\n\nconst allowedRec = ['Shortlist', 'Reject', 'Manual Review'];\nconst isValid = !!parsed\n  && Array.isArray(parsed.skills)\n  && typeof parsed.score === 'number'\n  && allowedRec.includes(parsed.recommendation)\n  && typeof parsed.reason === 'string';\n\nif (!isValid) {\n  console.log('[recruitment-ai] Parse/validation FAILED. Raw (first 400 chars):', text.slice(0, 400));\n  parsed = { skills: [], experience_years: 0, score: 0, recommendation: 'Manual Review',\n             reason: 'AI output could not be parsed — routed to manual review automatically.' };\n} else {\n  console.log(`[recruitment-ai] AI recommendation=${parsed.recommendation} score=${parsed.score}`);\n}\n\nreturn [{ json: { ...$('Extract Candidate Information').item.json, ai: parsed, ai_parse_ok: isValid } }];\n"
      },
      "id": "aaa51af4-48d3-4811-87bb-66bf47c8eedd",
      "name": "Parse & Validate AI Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -432,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "// Combines deterministic business rules with the AI's assessment.\n// Any disagreement between the rule engine and the AI is escalated to Manual Review\n// rather than silently trusting either one — final call always stays with a human.\nconst d = $input.item.json;\nconst requiredSkills = ['JavaScript', 'SQL', 'REST APIs', 'Problem Solving'];\nconst aiSkills = (d.ai.skills || []).map(s => String(s).toLowerCase());\n\nconst matched = requiredSkills.filter(rs => aiSkills.some(as => as.includes(rs.toLowerCase()) || rs.toLowerCase().includes(as)));\nconst ruleScore = Math.round((matched.length / requiredSkills.length) * 100);\n\nlet ruleRecommendation;\nif (ruleScore >= 75 && d.years_experience >= 1) ruleRecommendation = 'Shortlist';\nelse if (ruleScore < 25) ruleRecommendation = 'Reject';\nelse ruleRecommendation = 'Manual Review';\n\nconst finalScore = Math.round((ruleScore + d.ai.score) / 2);\nconst finalRecommendation = (ruleRecommendation === d.ai.recommendation)\n  ? ruleRecommendation\n  : 'Manual Review';\n\nreturn [{\n  json: {\n    ...d,\n    rule_matched_skills: matched,\n    rule_score: ruleScore,\n    rule_recommendation: ruleRecommendation,\n    final_score: finalScore,\n    final_recommendation: finalRecommendation,\n  }\n}];\n"
      },
      "id": "4488fb3c-14b9-45cb-96a1-33dce2425178",
      "name": "Rule-Based + AI Assessment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
