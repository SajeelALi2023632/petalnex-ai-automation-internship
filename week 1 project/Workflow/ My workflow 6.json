    {
      "parameters": {
        "jsCode": "// Loop over input items and check that required fields are filled in.\n// Adds 'isValid' (boolean) and 'missingFields' (string, or \"None\" if nothing is missing).\n\nconst requiredFields = ['Name', 'Email', 'Degree', 'Skills', 'Experience', 'Availability'];\n\nfor (const item of $input.all()) {\n  const missing = requiredFields.filter(field => {\n    const value = item.json[field];\n    return value === undefined || value === null || value.toString().trim() === '';\n  });\n\n  item.json.missingFields = missing.length === 0 ? 'None' : missing.join(', ');\n  item.json.isValid = missing.length === 0;\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -96,
        -16
      ],
      "id": "a2941e38-66ee-4d55-a4a7-5c7a77a4d073",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "// Apply screening rules: calculate Degree + Experience points\nconst items = $input.all();\n\nreturn items.map(item => {\n  const json = item.json;\n  const degreeText = (json.Degree || '').toLowerCase();\n  const expYears = parseFloat((json.Experience || '').toString()) || 0;\n\n  // Degree points\n  let degreePoints = 0;\n  if (degreeText.includes('ph.d') || degreeText.includes('phd')) {\n    degreePoints = 3;\n  } else if (degreeText.includes('m.s') || degreeText.includes('m.a') || degreeText.includes('m.b.a') || degreeText.startsWith('m.')) {\n    degreePoints = 2;\n  } else if (degreeText.includes('b.s') || degreeText.includes('b.a')) {\n    degreePoints = 1;\n  }\n\n  // Experience points\n  let expPoints = 0;\n  if (expYears >= 3) {\n    expPoints = 2;\n  } else if (expYears >= 1) {\n    expPoints = 1;\n  }\n\n  const score = degreePoints + expPoints;\n\n  return {\n    json: {\n      ...json,\n      degreePoints,\n      expPoints,\n      score\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
