        },
        "messages": {
          "values": [
            {
              "content": "=You are an AI Support Triage Agent. \nAnalyze the customer support message below and output ONLY a valid JSON object strictly following this format:\n\n{\n  \"category\": \"Billing\",\n  \"priority\": \"High\",\n  \"sentiment\": \"Frustrated\",\n  \"department\": \"Finance\",\n  \"summary\": \"1-2 sentence summary of the issue.\",\n  \"suggested_response\": \"Professional reply template to send to customer.\"\n}\n\nAllowed values:\n- category: \"Billing\", \"Technical\", \"Sales\", \"General\"\n- priority: \"Low\", \"Medium\", \"High\", \"Urgent\"\n- sentiment: \"Positive\", \"Neutral\", \"Negative\", \"Frustrated\"\n- department: \"Finance\", \"Engineering\", \"Sales Support\", \"Customer Care\"\n\nCustomer Message:\n{{ $json.body.customer_message }}"
            }
          ]
        },
        "jsonOutput": true,
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        -128,
        -224
      ],
      "id": "f72bed74-08eb-4a08-9ea8-e24b893e03ea",
      "name": "Message a model",
      "retryOnFail": false,
      "waitBetweenTries": 2000,
      "credentials": {
        "googlePalmApi": {
          "id": "2iuYFOKF0RtEigVq",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Access the text directly from the Gemini output structure\nconst item = $input.first().json;\nconst rawText = item.content?.parts?.[0]?.text || item.text || item.content || \"\";\n\n// Clean markdown syntax ```json ... ``` if present\nconst cleanedText = String(rawText)\n  .replace(/```json/gi, '')\n  .replace(/```/g, '')\n  .trim();\n\n// Parse string to JSON object\nconst parsedData = JSON.parse(cleanedText);\n\nreturn {\n  json: parsedData\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
