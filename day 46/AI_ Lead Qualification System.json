    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\n\nconst errors = [];\n\nif (!body.name || body.name.trim() === '') errors.push('Missing name');\nif (!body.email || body.email.trim() === '') errors.push('Missing email');\n\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nif (body.email && !emailRegex.test(body.email)) errors.push('Invalid email format');\n\nif (errors.length > 0) {\n  return [{\n    json: {\n      valid: false,\n      errors: errors,\n      original: body\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    valid: true,\n    name: body.name.trim(),\n    email: body.email.trim().toLowerCase(),\n    company: body.company || null,\n    phone: body.phone || null,\n    message: body.message || null,\n    source: 'webhook'\n  }\n}];"
      },
