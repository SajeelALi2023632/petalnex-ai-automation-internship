    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Deterministic parse + validation of AI output, with structured retry-style result object.\n// Works whether this item came from the Gemini agent or the Groq fallback agent.\n\nlet attempts = 1;\nlet success = false;\nlet error = null;\nlet parsed = null;\n\ntry {\n  const output = $json.output ?? $json;\n\n  // n8n's structured output parser typically returns the parsed object directly\n  // under `output`, but fall back to parsing raw text if needed.\n  if (typeof output === 'object' && output.score !== undefined) {\n    parsed = output;\n  } else if (typeof output === 'string') {\n    parsed = JSON.parse(output);\n  } else {\n    throw new Error('Unrecognized AI output shape');\n  }\n\n  if (\n    typeof parsed.score !== 'number' ||\n    !['hot', 'warm', 'cold'].includes(parsed.status) ||\n    typeof parsed.reasoning !== 'string'\n  ) {\n    throw new Error('AI output failed schema validation');\n  }\n\n  success = true;\n} catch (err) {\n  error = err.message;\n  // Safe fallback so the pipeline never silently drops a lead\n  parsed = {\n    score: 0,\n    status: 'cold',\n    reasoning: 'AI qualification failed; defaulted to cold for manual review.'\n  };\n}\n\nreturn {\n  json: {\n    success,\n    statusCode: success ? 200 : 500,\n    error,\n    attempts,\n    score: parsed.score,\n    status: parsed.status,\n    reasoning: parsed.reasoning,\n    id: $('Supabase - Insert Lead').item.json.id,\n    name: $('Supabase - Insert Lead').item.json.name,\n    email: $('Supabase - Insert Lead').item.json.email,\n    company: $('Supabase - Insert Lead').item.json.company\n  }\n};"
      },
