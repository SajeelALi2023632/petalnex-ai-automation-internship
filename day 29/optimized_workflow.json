    {
      "parameters": {
        "jsCode": "// Deterministic replacement for the old LLM-based autoFix step.\n// Parses the raw text from the Basic LLM Chain, repairs common formatting\n// issues (markdown fences, stray text), validates against the schema,\n// and logs the outcome. No second AI call.\n\nconst raw = $input.item.json.text ?? '';\nlet text = String(raw).trim();\n\n// Strip markdown code fences if the model wrapped the JSON in them\ntext = text.replace(/^```(?:json)?/i, '').replace(/```$/, '').trim();\n\nfunction tryParse(str) {\n  try { return JSON.parse(str); } catch (e) { return null; }\n}\n\nlet parsed = tryParse(text);\nif (!parsed) {\n  // Fallback: extract the first {...} block and try again\n  const match = text.match(/\\{[\\s\\S]*\\}/);\n  if (match) parsed = tryParse(match[0]);\n}\n\nconst allowedCategory = ['Sales','Support','Complaint','Invoice','Spam','General','Unknown'];\nconst allowedPriority = ['Low','Medium','High'];\nconst allowedSentiment = ['Positive','Neutral','Negative'];\n\nconst isValid = !!parsed\n  && allowedCategory.includes(parsed.category)\n  && allowedPriority.includes(parsed.priority)\n  && allowedSentiment.includes(parsed.sentiment)\n  && typeof parsed.department === 'string'\n  && typeof parsed.summary === 'string';\n\nif (!isValid) {\n  console.log('[email-router] Parse/validation FAILED. Raw output (first 500 chars):', text.slice(0, 500));\n  return [{\n    json: {\n      output: {\n        category: 'Unknown',\n        priority: 'Medium',\n        sentiment: 'Neutral',\n        department: 'Unassigned',\n        summary: 'Auto-classification failed validation; routed for manual review.'\n      },\n      parseOk: false\n    }\n  }];\n}\n\nconsole.log(`[email-router] Classified OK -> category=${parsed.category} priority=${parsed.priority} sentiment=${parsed.sentiment}`);\n\nreturn [{ json: { output: parsed, parseOk: true } }];\n"
      },
      "id": "c1a2b3c4-1111-4a2b-9c3d-parsevalidate01",
      "name": "Parse & Validate Classification",
      "type": "n8n-nodes-base.code",
