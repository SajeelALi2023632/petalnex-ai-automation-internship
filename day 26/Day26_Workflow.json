      "parameters": {
        "jsCode": "const url = 'https://this-domain-does-not-exist-xyz123.com';\nconst maxTries = 3;\nconst waitMs = 1000;\n\nlet success = false;\nlet statusCode = null;\nlet lastError = null;\n\nfor (let attempt = 1; attempt <= maxTries; attempt++) {\n  try {\n    const response = await fetch(url, { method: 'GET' });\n    statusCode = response.status;\n    if (response.ok) {\n      success = true;\n      break;\n    } else {\n      lastError = `HTTP ${response.status}`;\n    }\n  } catch (error) {\n    lastError = error.message;\n  }\n  if (attempt < maxTries) {\n    await new Promise((resolve) => setTimeout(resolve, waitMs));\n  }\n}\n\nreturn [\n  {\n    json: {\n      success,\n      statusCode,\n      error: success ? null : lastError,\n      attempts: maxTries,\n      url,\n      timestamp: new Date().toISOString()\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-336, -32],
