        "jsCode": "const amount = $json.requestedAmount;\nlet recommendation, reasoning;\n\nif (amount <= 100) {\n  recommendation = 'Approve';\n  reasoning = 'Low-value refund, matches standard policy for damaged-item claims.';\n} else {\n  recommendation = 'Approve (manager sign-off required)';\n  reasoning = 'Refund exceeds the $100 auto-approval threshold, so it is routed to a human for final sign-off before anything is processed.';\n}\n\nreturn [{\n  json: {\n    ...$json,\n    aiRecommendation: recommendation,\n    aiReasoning: reasoning\n  }\n}];"
      },
