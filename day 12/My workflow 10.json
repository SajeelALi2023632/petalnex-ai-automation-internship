      "name": "Webhook",
      "webhookId": "98e48853-e02d-4d09-8f47-bd8d0f22080d"
    },
    {
      "parameters": {
        "jsCode": "// Validation Node — n8n Code node\n// Mode: Run Once for Each Item\n\nconst item = $input.item.json.body;\nconst errors = [];\n\n// Required fields\nconst requiredFields = ['name', 'email', 'company', 'service', 'budget'];\nfor (const field of requiredFields) {\n  if (\n    item[field] === undefined ||\n    item[field] === null ||\n    String(item[field]).trim() === ''\n  ) {\n    errors.push(`Missing required field: ${field}`);\n  }\n}\n\n// Email format check (basic, not exhaustive)\nif (item.email) {\n  const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n  if (!emailRegex.test(item.email.trim())) {\n    errors.push('Invalid email format');\n  }\n}\n\n// Budget must be a valid positive number\nif (item.budget !== undefined && item.budget !== null && item.budget !== '') {\n  const budgetNum = Number(item.budget);\n  if (isNaN(budgetNum) || budgetNum < 0) {\n    errors.push('Budget must be a valid positive number');\n  }\n}\n\n// Name should not be suspiciously short (basic sanity check)\nif (item.name && item.name.trim().length < 2) {\n  errors.push('Name is too short');\n}\n\nreturn {\n  json: {\n    ...item,\n    isValid: errors.length === 0,\n    validationErrors: errors\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -256,
        16
      ],
      "id": "44730823-46fa-4e86-bc55-eac1fa2a1bcb",
      "name": "Validation"
    },
    {
      "parameters": {
        "jsCode": "// Lead Processing Node — n8n Code node\n// Mode: Run Once for All Items\n\nconst items = $input.all();\nconst freeEmailProviders = ['gmail.com', 'yahoo.com', 'hotmail.com', 'outlook.com', 'icloud.com'];\n\nconst results = items.map(entry => {\n  const item = entry.json;\n\n  let cleanBudget = item.budget;\n  if (typeof cleanBudget === 'string') {\n    cleanBudget = cleanBudget.replace(/[$,\\s]/g, '');\n  }\n  cleanBudget = Number(cleanBudget) || 0;\n\n  const cleanName = String(item.name || '').trim();\n  const cleanEmail = String(item.email || '').trim().toLowerCase();\n  const cleanCompany = String(item.company || '').trim();\n  const cleanService = String(item.service || '').trim();\n\n  const emailDomain = cleanEmail.includes('@') ? cleanEmail.split('@')[1] : '';\n  const isBusinessEmail = emailDomain && !freeEmailProviders.includes(emailDomain);\n\n  const leadId = `LEAD-${Date.now()}-${Math.floor(Math.random() * 1000)}`;\n  const receivedAt = new Date().toISOString();\n\n  return {\n    json: {\n      leadId,\n      name: cleanName,\n      email: cleanEmail,\n      emailDomain,\n      isBusinessEmail,\n      company: cleanCompany,\n      hasCompany: cleanCompany.length > 0,\n      service: cleanService,\n      budget: cleanBudget,\n      receivedAt\n    }\n  };\n});\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -48,
        16
      ],
      "id": "ac390cf7-6cbd-4322-923f-3ad7f24e5ea8",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "// Lead Scoring Node — n8n Code node\n// Mode: Run Once for Each Item\n\nconst item = $input.item.json;\nlet score = 0;\n\n// --- Budget scoring ---\nif (item.budget > 10000) {\n  score += 30;\n} else if (item.budget >= 2000) {\n  score += 15;\n} else {\n  score += 5;\n}\n\n// --- Service type scoring ---\nconst highValueServices = ['enterprise', 'premium', 'custom'];\nconst serviceLower = (item.service || '').toLowerCase();\nconst isHighValueService = highValueServices.some(keyword => serviceLower.includes(keyword));\nif (isHighValueService) {\n  score += 20;\n}\n\n// --- Company provided ---\nif (item.hasCompany) {\n  score += 10;\n}\n\n// --- Business email (not gmail/yahoo/etc.) ---\nif (item.isBusinessEmail) {\n  score += 10;\n}\n\n// --- Determine priority tier ---\nlet priority;\nif (score >= 50) {\n  priority = 'High';\n} else if (score >= 25) {\n  priority = 'Medium';\n} else {\n  priority = 'Low';\n}\n\nreturn {\n  json: {\n    ...item,\n    score,\n    priority\n  }\n};"
      },
