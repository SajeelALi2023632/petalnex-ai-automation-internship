    {
      "parameters": {
        "jsCode": "const responseText = ($input.item.json.text || $input.item.json.output || '').trim();\nconst ticket = $('Combine KB Context').item.json;\n\n// Only escalate if High Priority, Frustrated Sentiment, or non-General Inquiry\nconst requiresEscalation = Boolean(\n  ticket.priority === 'High' ||\n  ticket.sentiment === 'Frustrated' ||\n  ticket.category !== 'General Inquiry'\n);\n\nreturn [{\n  json: {\n    ...ticket,\n    suggested_response: responseText,\n    requires_escalation: requiresEscalation\n  }\n}];"
      },
