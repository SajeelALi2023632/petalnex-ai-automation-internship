      "parameters": {
        "jsCode": "const f = $input.item.json;\nconst clientName = String(f['Client Name'] || '').trim();\nconst clientEmail = String(f['Email'] || '').trim().toLowerCase();\nconst projectName = String(f['Project Name'] || '').trim();\nconst message = String(f['Message'] || '').replace(/\\s+/g, ' ').trim();\n\nreturn [{\n  json: {\n    client_name: clientName,\n    client_email: clientEmail,\n    project_name: projectName,\n    message: message,\n    submitted_at: new Date().toISOString(),\n    status: 'Open'\n  }\n}];"
