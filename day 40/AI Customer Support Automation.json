    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a support agent drafting a direct reply for Petalnex client inquiries.\n\nClient message: {{ $json.message }}\nCategory: {{ $json.category }}\nKnowledge base context:\n{{ $json.kb_context }}\n\nInstructions:\n- If knowledge-base context provides the solution, draft a concise, friendly resolution.\n- If context does not cover the question, acknowledge the message and state that our specialized support team is reviewing it.\n- Return ONLY the body text of the reply. No email headers or signatures.",
        "batching": {}
      },
