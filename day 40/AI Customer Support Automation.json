    {
      "parameters": {
        "jsCode": "const matches = $input.all();\nconst ticket = $('Parse & Prioritize').item.json;\n\nconst validMatches = matches.filter(m => (m.json.pageContent || m.json.content || '').trim().length > 0);\nconst kbContext = validMatches.map(m => m.json.pageContent || m.json.content).join('\\n\\n---\\n\\n');\n\nreturn [{\n  json: {\n    ...ticket,\n    kb_context: kbContext,\n    kb_context_found: validMatches.length > 0\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
