    {
      "parameters": {
        "jsCode": "// Merge validation data with enrichment result\nconst lead = $('Validate').item.json;\nconst enrichment = $input.item.json;\n\nreturn [{\n  json: {\n    name: lead.name,\n    email: lead.email,\n    company: lead.company,\n    phone: lead.phone,\n    message: lead.message,\n    domain: lead.domain,\n    disposable_email: enrichment.disposable || false,\n    dns_valid: enrichment.dns || false,\n    confidence_score: enrichment.confidence ?? null,\n    processed_at: new Date().toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        -144
      ],
      "id": "6dd04802-da23-48e4-856b-609ee0e861ff",
      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "jsCode": "// Validate incoming lead data\nconst body = $input.item.json.body;\n\nconst errors = [];\n\nif (!body.name || body.name.trim() === '') {\n  errors.push('name is required');\n}\nif (!body.email || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(body.email)) {\n  errors.push('a valid email is required');\n}\nif (!body.company || body.company.trim() === '') {\n  errors.push('company is required');\n}\n\nif (errors.length > 0) {\n  return [{\n    json: {\n      valid: false,\n      errors,\n      original: body\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    valid: true,\n    name: body.name,\n    email: body.email,\n    company: body.company,\n    phone: body.phone || null,\n    message: body.message || null,\n    domain: body.email.split('@')[1]\n  }\n}];"
      },
