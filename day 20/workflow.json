    {
      "parameters": {
        "jsCode": "const results = [];\nconst items = $input.all();\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  let text = item.json.data || item.json.text || '';\n  text = text\n    .replace(/\\r\\n/g, '\\n')\n    .replace(/[ \\t]+/g, ' ')\n    .replace(/\\n{3,}/g, '\\n\\n')\n    .trim();\n  if (!text) continue;\n\n  const sourceItem = $('Read/Write Files from Disk').all()[i];\n  const fileName = sourceItem?.binary?.data?.fileName || 'unknown';\n\n  results.push({\n    json: {\n      content: text,\n      source: fileName,\n    }\n  });\n}\nreturn results;"
      },
