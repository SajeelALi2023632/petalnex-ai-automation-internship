    {
      "parameters": {
        "jsCode": "// Deterministic normalization of the raw form submission.\n// No AI involved here on purpose — this is pure data hygiene.\nconst f = $input.item.json;\n\nconst clientName = String(f['Client Name'] || '').trim();\nconst clientEmail = String(f['Email'] || '').trim().toLowerCase();\nconst projectName = String(f['Project Name'] || '').trim();\nconst message = String(f['Message'] || '').replace(/\\s+/g, ' ').trim();\n\n// Basic validation — deterministic error handling before anything costs an AI call\nconst errors = [];\nif (!clientName) errors.push('Missing client name');\nif (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(clientEmail)) errors.push('Invalid email');\nif (message.length < 15) errors.push('Message too short to classify');\n\nreturn [{\n  json: {\n    client_name: clientName,\n    client_email: clientEmail,\n    project_name: projectName,\n    message: message,\n    submitted_at: new Date().toISOString(),\n    validation_errors: errors,\n    is_valid: errors.length === 0,\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
