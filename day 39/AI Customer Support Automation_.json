    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a support ticket classifier for Petalnex, a software/AI/automation services company. Analyze this client message and respond ONLY with valid JSON, no other text.\n\nClient message: {{ $json.message }}\nProject: {{ $json.project_name }}\n\nClassify into exactly one category: \"Technical Issue\", \"Integration/API\", \"Project Status\", \"Bug Report\", \"Feature Request\", \"Billing\", or \"General Inquiry\".\n\nAnalyze sentiment as: \"Frustrated\", \"Neutral\", or \"Positive\", with a sentiment_score from 0 (very negative) to 100 (very positive).\n\nRespond in this exact JSON shape:\n{\n  \"category\": \"...\",\n  \"sentiment\": \"...\",\n  \"sentiment_score\": 0,\n  \"reasoning\": \"one sentence explaining the classification\"\n}",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        -368,
        0
      ],
      "id": "9c66650e-dfe4-4c30-8b49-e067a89664ec",
      "name": "Basic LLM Chain"
    },
    {
      "parameters": {
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        -368,
        208
      ],
      "id": "52c3d8ba-10b3-492a-93a8-bee8983bcf7a",
      "name": "Google Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": "2iuYFOKF0RtEigVq",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parses and validates the AI's classification/sentiment output before anything downstream trusts it.\nconst raw = $input.item.json.text || $input.item.json.output || '';\nlet parsed;\ntry {\n  const jsonMatch = raw.match(/\\{[\\s\\S]*\\}/);\n  parsed = JSON.parse(jsonMatch ? jsonMatch[0] : raw);\n} catch (e) {\n  parsed = null;\n}\n\nconst validCategories = ['Technical Issue', 'Integration/API', 'Project Status', 'Bug Report', 'Feature Request', 'Billing', 'General Inquiry'];\nconst validSentiments = ['Frustrated', 'Neutral', 'Positive'];\n\nconst isValid = parsed\n  && validCategories.includes(parsed.category)\n  && validSentiments.includes(parsed.sentiment)\n  && Number.isFinite(Number(parsed.sentiment_score));\n\nreturn [{\n  json: {\n    ...$('valid submission').item.json,\n    ai_category: isValid ? parsed.category : 'General Inquiry',\n    ai_sentiment: isValid ? parsed.sentiment : 'Neutral',\n    ai_sentiment_score: isValid ? Number(parsed.sentiment_score) : 50,\n    ai_reasoning: isValid ? parsed.reasoning : 'AI output could not be parsed; defaulted to General Inquiry.',\n    ai_parse_failed: !isValid,\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "id": "83469ff1-f6fd-46a6-837b-ebb57cecc923",
      "name": "Parse & Validate AI Output"
    },
    {
      "parameters": {
        "jsCode": "// Rule-based signals + AI sentiment combine to set priority. Never AI-only.\nconst d = $input.item.json;\nconst urgentPhrases = ['production', 'down', 'urgent', 'asap', 'not working', 'broken', 'critical'];\nconst msg = d.message.toLowerCase();\nconst hasUrgentLanguage = urgentPhrases.some(p => msg.includes(p));\n\nlet priority;\nif (hasUrgentLanguage || d.ai_sentiment_score < 20) priority = 'High';\nelse if (d.ai_sentiment === 'Frustrated' || d.ai_sentiment_score < 50) priority = 'Medium';\nelse priority = 'Low';\n\n// Anything except a routine General Inquiry, or any parse failure, forces human review\nconst needsHumanReview = d.ai_category !== 'General Inquiry' || d.ai_parse_failed || priority === 'High';\n\nreturn [{ json: { ...d, priority, needs_human_review: needsHumanReview } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
